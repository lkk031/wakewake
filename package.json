{
  "name": "wakewake",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @wakewake/mobile start",
    "android": "corepack pnpm --filter @wakewake/mobile android",
    "ios": "corepack pnpm --filter @wakewake/mobile ios",
    "web": "corepack pnpm --filter @wakewake/mobile web",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
